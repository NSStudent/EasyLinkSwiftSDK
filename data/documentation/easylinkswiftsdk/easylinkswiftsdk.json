{"identifier":{"url":"doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/EasyLinkSwiftSDK","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"EasyLinkSwiftSDK is a native Swift package for communicating with Chessnut boards on iOS 16 and macOS 13 or later. It uses CoreBluetooth, exposes async APIs, and publishes realtime board positions through "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/EasyLinkScanner","type":"reference","isActive":true},{"type":"text","text":" when your app needs to show real Bluetooth devices in a picker. Use "},{"identifier":"doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/EasyLinkClient","type":"reference","isActive":true},{"type":"text","text":" to connect, enable realtime updates, query battery state, set LEDs, import OTB games stored on the board, and use Chessnut Move specific commands."}],"type":"paragraph"},{"code":["for await device in EasyLinkScanner.scan(profile: .move) {","  print(device.name)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"After the user selects a device, create a client for that exact peripheral:"}],"type":"paragraph"},{"code":["let client = EasyLinkClient(device: selectedDevice)","try await client.connect()","try await client.enableRealtimeUpdates()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Discover and control Chessnut electronic chessboards over Bluetooth Low Energy.","type":"text"}],"metadata":{"modules":[{"name":"EasyLinkSwiftSDK"}],"title":"EasyLinkSwiftSDK","role":"collectionGroup","roleHeading":"API Collection"},"topicSections":[{"identifiers":["doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/DiscoveryAndConnect