{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"EasyLinkSwiftSDK is a native Swift package for communicating with Chessnut boards on iOS 16 and macOS 13 or later. It uses CoreBluetooth, exposes async APIs, and publishes realtime board positions through "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/EasyLinkScanner"},{"text":" when your app needs to show real Bluetooth devices in a picker. Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/EasyLinkClient"},{"text":" to connect, enable realtime updates, query battery state, set LEDs, and use Chessnut Move specific commands.","type":"text"}],"type":"paragraph"},{"code":["for await device in EasyLinkScanner.scan(profile: .move) {","  print(device.name)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"After the user selects a device, create a client for that exact peripheral:"}],"type":"paragraph"},{"code":["let client = EasyLinkClient(device: selectedDevice)","try await client.connect()","try await client.enableRealtimeUpdates()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/EasyLinkSwiftSDK"},"metadata":{"modules":[{"name":"EasyLinkSwiftSDK"}],"roleHeading":"API Collection","role":"collectionGroup","title":"EasyLinkSwiftSDK"},"topicSections":[{"title":"Discovery","anchor":"Discovery","identifiers":["doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/DiscoveryAndConnection","doc:\/\/EasyLinkSwiftSDK\/documentation\/EasyLinkSwiftSDK\/EasyLinkScanner","doc:\/\/EasyLinkSwiftSDK\/docume